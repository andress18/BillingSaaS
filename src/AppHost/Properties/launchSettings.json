      "dotnetRunMessages": true,
      "launchBrowser": true,
      "applicationUrl": "https://billingsaas.dev.localhost:17038;http://billingsaas.dev.localhost:15234",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "DOTNET_ENVIRONMENT": "Development",
        "DOTNET_DASHBOARD_OTLP_ENDPOINT_URL": "https://localhost:21267",
        "DOTNET_RESOURCE_SERVICE_ENDPOINT_URL": "https://localhost:22235"
      }
    },
    "http": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": true,
      "applicationUrl": "http://billingsaas.dev.localhost:15234",
      "environmentVariables": {
        "ASPIRE_ALLOW_UNSECURED_TRANSPORT": "true",
